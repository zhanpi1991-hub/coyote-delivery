# Coyote Delivery Environment Configuration Example
# Copy this file to .env and configure strong values.

# REQUIRED: Secret key used to sign and verify JWT authentication tokens (at least 32 characters)
JWT_SECRET_KEY=replace_with_a_secure_random_string_at_least_32_characters_long

# OPTIONAL: Database connection URL (defaults to local SQLite if omitted)
# DATABASE_URL=sqlite:///coyote_delivery.db

# OPTIONAL: Comma-separated list of trusted CORS origins.
# Defaults to http://localhost:5173,http://127.0.0.1:5173 (Vite dev server) when unset.
# Set this for production to your actual frontend domain(s).
# Example: COYOTE_CORS_ORIGINS=https://delivery.example.com,https://admin.example.com
# COYOTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

